  "narrative": {
    "northStar": "The Proving Ground",
    "overview": "Proving Ground is a working application for comparing Earth field-test conditions with Moon and Mars targets. The NASA Eyes reference informs the exploration canvas: dark blue ground, readable slate surfaces, bright neutral type and restrained teal actions. The light theme uses cool white surfaces with the same information hierarchy.\n\nThe interface gives the map, comparison controls and scientific evidence room to be read on a laptop or phone. Presentation choices do not change source data, scoring weights, thresholds or missing-data semantics. Product context lives in `../docs/project-brief.md` and `../docs/mission-plan.md`; measured facts live in `../docs/verified-facts.md`. This document records the implemented system, not a paused design draft.",
    "keyCharacteristics": [
      "Separate identity/actions row and five tool tabs.",
      "Local IBM Plex Sans, clear hierarchy and generous control targets.",
      "Explicit score coverage, evidence labels and missing-data reasons.",
      "Real Google imagery when configured; local scientific views remain available."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Keep literal Estimate, Measured and Simulated labels visible. A label never changes missing data into data. Show a labelled score legend and the reason a score is missing; curve keys name their sources and distinguish line styles.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Preserve the distinction between body copy, navigation labels and metadata. Keep numeric comparisons aligned with tabular figures and retain visible units.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the actual CSS tokens in both themes and preserve visible focus states.",
      "Do keep score, coverage, evidence labels, units and missing-data reasons readable together.",
      "Do retain all ranked cell links, map modes, source attribution and explicit recovery states.",
      "Do verify changes against the actual application at desktop and narrow widths."
    ],
    "donts": [
      "Don't change scientific values, score weights or missing-data semantics for presentation.",
      "Don't use the zero-score color for missing scores or color alone to name a curve.",
      "Don't filter Google imagery, obscure its attribution or present satellite tiles as the score layer.",
      "Don't commit a real browser key or require a font service for interface type."
    ]
  }
}
