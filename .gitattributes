# U05 numeric layers must never undergo line-ending conversion or text merging.
app/public/data/earth/*.bin binary

# Preserve the complete Horizons reference responses, including source whitespace.
pipeline/tests/fixtures/horizons-pod-events-*.txt -text whitespace=-blank-at-eol
app/public/data/sun/pod-prediction-horizons.txt -text whitespace=-blank-at-eol

# Preserve the downloaded NASA fixture bytes and their source XML whitespace.
pipeline/tests/fixtures/meda-sol-300/*.CSV -text whitespace=cr-at-eol
pipeline/tests/fixtures/meda-sol-300/*.xml -text whitespace=-blank-at-eol

# Preserve the fetched outline response byte-for-byte on Windows checkouts.
app/public/data/geo/*.geojson -text
